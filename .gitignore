# Secrets — never commit the real environment file
.env
# setup.sh's own temp-write-then-move target (T317, SPEC F132.4/AC4) — normally renamed to
# .env before the process exits, but the EXIT trap only cleans up a leftover if the run was
# killed mid-write; this is a backstop against staging one by accident regardless.
.env.setup.*

# .NET build output
bin/
obj/
*.user

# Claude session artifacts
docs/

# Internal-only analysis — must stay ignored even if docs/ is ever un-ignored
docs/audit/

# Smoke-test artifacts
smoke-candidates.json
*.wav
*-smoke.png

# Playwright MCP session artifacts
.playwright-mcp/

# IDE + OS noise
.idea/
.vs/
TestResults/
.DS_Store

# Agent worktrees (Claude Code `isolation: worktree`) — full repo checkouts, one per
# subagent run. 3.6 GB on this machine as of 2026-07-31, and a plain `git add -A`
# will happily try to stage every one of them.
.claude/worktrees/
