# .env.example — copy to .env and fill in. compose.yaml reads these via ${VAR:?} and will
# refuse to start (with a clear error) if a required one is missing. NEVER commit the real .env.
#
#   cp .env.example .env   # then edit
#
# Values must be UNQUOTED, even ones containing spaces (e.g. STATION_NAME=GWAV 108.8) —
# compose itself would tolerate quotes, but GenWave's shell tooling (launch.sh/preflight's
# `cut -d= -f2-` reader) reads the text after `=` literally, so quote characters would become
# part of the value everywhere except inside compose.

# Station name shown on listeners' radios (icy-name header + StreamTitle prefix) and fed to the
# API as Station__Name. Optional — defaults to "GWAV 108.8".
#STATION_NAME=My GenWave Station

# Which compose profiles to activate (F61.4/STORY-166). admin_ui is gated behind the "admin"
# profile so public-facing boxes never run a Node runtime. Four operating modes
# (Admin:Enabled x Station:SpectatorMode, see docs/ARCHITECTURE.md "Operating modes & topology"):
#   Operator/Standard (default, this line as shipped) — keep COMPOSE_PROFILES=admin, admin_ui runs.
#   Appliance/Headless (public demo or streams-only box) — clear this line (or comment it out) so
#     `docker compose up` never starts admin_ui; the api-side 404 remains the fail-safe even if
#     admin_ui somehow runs anyway.
COMPOSE_PROFILES=admin

# Absolute path to your music library on the host. Both the engine and the api mount it read-only at
# /media (the engine plays, the library scans + analyses; neither writes).
MEDIA_DIR=/absolute/path/to/your/music/library

# How many files the ffmpeg loudness/cue/energy analyzers enrich concurrently (gh-#334).
# Unset = 4 on the normal stack, 2 under compose.piper-only.yaml (the low-memory topology, see
# HARDWARE.md). Enrichment is the heaviest sustained load GenWave produces: on a 4-core box the
# default pins every core, which on a Raspberry Pi drives the SoC past its thermal soft limit and
# the 5V rail into undervoltage. Lower it if the box browns out, throttles, or you want headroom
# for playout; raise it on a machine with cores to spare (ceiling 32, per SPEC F53.1).
# LIBRARY_ENRICHMENT_CONCURRENCY=2

# Postgres superuser password (owns the `genwave` database; used by db init).
POSTGRES_PASSWORD=change-me-postgres

# Password for the dedicated `library_svc` role — the only DB login the api uses.
# Created on first db boot by db/01-library.sh; the api connects with it via ConnectionStrings__Library.
LIBRARY_DB_PASSWORD=change-me-library

# Password for the dedicated `station_svc` role — used by the api for station settings/personas.
# Created on first db boot by db/06-station-settings-migration.sh; the api connects with it via
# ConnectionStrings__Station.
STATION_DB_PASSWORD=change-me-station

# Icecast source password — the engine uses this to connect as the stream source.
ICECAST_SOURCE_PASSWORD=change-me-source

# Icecast admin password — guards /admin. Make it strong.
ICECAST_ADMIN_PASSWORD=change-me-admin

# Public hostname for the reference public-station topology (compose.demo.yaml + Caddyfile
# + DEPLOYMENT.md). Only read when you run that overlay; Caddy obtains TLS for it.
PUBLIC_HOST=radio.example.com

# Single admin password for the Admin UI login (no user table — one deployment, one station).
# REQUIRED for any admin access: leave blank and the admin plane fail-closes — every admin
# endpoint denies and login can never succeed (no local-dev open mode).
ADMIN_PASSWORD=change-me-admin-ui

# Cloudflare Tunnel token (remote-managed tunnel) — ONLY needed when the optional `cloudflared`
# service is enabled via COMPOSE_PROFILES=tunnel (see DEPLOYMENT.md "Cloudflare tunnel
# (optional)"). Leave blank otherwise — the profile never starts by default, and the container
# itself fails fast with a clear error if this is blank/invalid while the profile IS active.
# Create the tunnel + fetch this token from the Cloudflare Zero Trust dashboard (Networks >
# Tunnels > your tunnel > Configure > Install & run a connector).
TUNNEL_TOKEN=
