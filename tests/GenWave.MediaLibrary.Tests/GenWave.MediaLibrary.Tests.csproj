<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- For Options.Create + NullLogger + Channels when constructing the services directly. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\..\src\GenWave.MediaLibrary\GenWave.MediaLibrary.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- gh-#649, STORY-440, PLAN T477: TestNetwork.Ensure is shared with GenWave.Host.Tests as a
         linked compile item rather than a ProjectReference — there is no Host.Tests→MediaLibrary.Tests
         reference, and one file shared by two assemblies is cheaper than a cross-test-project edge. -->
    <Compile Include="..\GenWave.Host.Tests\Support\TestNetwork.cs" Link="Support\TestNetwork.cs" />
    <!-- STORY-484, PLAN T591: Story484_SchemaJournal.cs drives the real ./migrate.sh (Support's
         Gh332/gh-#776 sanitized-process idiom), same cross-assembly-link reasoning as TestNetwork.cs
         above — no Host.Tests→MediaLibrary.Tests reference exists or is warranted for three files. -->
    <Compile Include="..\GenWave.Host.Tests\Support\ScriptProcess.cs" Link="Support\ScriptProcess.cs" />
    <Compile Include="..\GenWave.Host.Tests\Support\RepoRootLocator.cs" Link="Support\RepoRootLocator.cs" />
    <Compile Include="..\GenWave.Host.Tests\Support\TempDir.cs" Link="Support\TempDir.cs" />
    <!-- T591 review F5: MigrateShDatabase's own compose/port plumbing, shared rather than a third copy
         of what DatabaseFixture.cs and EphemeralStationDatabase.cs each already carry. -->
    <Compile Include="..\GenWave.Host.Tests\Support\ComposeProcess.cs" Link="Support\ComposeProcess.cs" />
  </ItemGroup>

</Project>
